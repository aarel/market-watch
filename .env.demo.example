# Demo-specific runtime config (no production secrets).
# Copy to .env.demo and fill values for demo-only credentials/secrets.

TRADING_MODE=paper
AUTO_TRADE=false
REQUIRE_APPROVAL=true
MARKET_WATCH_DEMO_MODE=true
FASTAPI_DISABLE_LIFESPAN=0
API_HOST=127.0.0.1
API_PORT=18000
ALLOWED_ORIGINS=https://demo.market-watch.example.com

# Security — set both for any public-facing deployment
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
API_TOKEN=
DISABLE_API_DOCS=1

# Isolated state and logs
CONFIG_STATE_PATH=data/demo/config_state.json
OBSERVABILITY_LOG_PATH=logs/demo/system/agent_events.jsonl
UI_CHECK_LOG_PATH=logs/demo/system/ui_checks.jsonl
TEST_AGENT_LOG_PATH=logs/demo/system/tests.jsonl

# Optional for strict isolation of replay data
REPLAY_RECORDER_DIR=data/demo/replay

# REQUIRED: set demo-specific (paper) credentials out of band
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
